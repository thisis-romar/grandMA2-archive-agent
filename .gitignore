*.exe
*.zip
*.imgz
*.update
*.show.gz
installers/

# ---- PowerShell ----
*.ps1xml.bak
PSReadLine/
*.tmp

# ---- OS cruft ----
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
$RECYCLE.BIN/

# ---- Editor ----
.vs/
.vscode/
*.suo
*.user
*~

