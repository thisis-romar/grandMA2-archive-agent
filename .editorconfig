root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# PowerShell — 4-space indent by convention
[*.{ps1,psm1,psd1}]
indent_size = 4

# Markdown — preserve trailing spaces (hard line breaks)
[*.md]
trim_trailing_whitespace = false

# Make/YAML keep their own conventions
[*.{yml,yaml}]
indent_size = 2
